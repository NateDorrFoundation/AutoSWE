# systemd user unit for the vendored agy Gemini->OpenAI bridge
# (scripts/agy-gemini-proxy.py). Install:
#   mkdir -p ~/.litellm-agy && cp scripts/agy-gemini-proxy.py ~/.litellm-agy/
#   echo 'AGY_PROXY_UPSTREAM_KEY=<real LiteLLM key>' > ~/.litellm-agy/proxy.env
#   (the real key lives ONLY in proxy.env — never commit it)
#   systemctl --user enable --now agy-gemini-proxy
# (linger on so it survives reboots: loginctl enable-linger $USER)
[Unit]
Description=agy Gemini->OpenAI bridge for AutoSWE antigravity backend
After=network-online.target

[Service]
ExecStart=%h/.venvs/agy-bridge/bin/python %h/.litellm-agy/gemini-openai-proxy.py
Environment=AGY_PROXY_UPSTREAM=http://linux-server1:4000/v1
EnvironmentFile=%h/.litellm-agy/proxy.env
WorkingDirectory=%h/.litellm-agy
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
